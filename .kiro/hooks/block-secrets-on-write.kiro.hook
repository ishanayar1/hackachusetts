{
  "enabled": true,
  "name": "Block secrets on write",
  "description": "Stops file writes that contain API keys or tokens. The repo is public, so keys live only in environment variables.",
  "version": "1",
  "when": {
    "type": "preToolUse",
    "toolTypes": ["write"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Before this write, check the content. If it contains an API key, token, password, database URL with credentials, or a value that looks like one (for example an MBTA key, an Anthropic key, a Better Auth secret), do not write it. Put the value in .env (gitignored), reference it as process.env.NAME, and add only the name with an empty value to .env.example. Never use NEXT_PUBLIC_ for a secret."
  }
}
