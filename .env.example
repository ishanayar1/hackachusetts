# MBTA V3 API key (optional, raises rate limits). Server-only.
MBTA_API_KEY=

# Postgres for users and sessions. Neon: Project > Connect > copy the pooled connection string.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Random 32+ chars: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Site URL. Locally http://localhost:3000; on Vercel your production URL.
BETTER_AUTH_URL=http://localhost:3000

# Optional sign-in buttons. A provider shows up only when both values are set.
# Google callback: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub callback: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
