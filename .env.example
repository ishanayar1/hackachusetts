# Copy this file to .env (local) and set the real values there. .env is gitignored.
# On Vercel, set these in Project Settings -> Environment Variables (NOT in the repo).

# MBTA V3 API key — powers live elevator/escalator alerts, vehicles, predictions.
# Get one free (instant) at https://api-v3.mbta.com  -> sent as the x-api-key header.
# SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_ (that ships it to every browser).
# Without it, the app still runs on cached/demo data but live calls share the
# unkeyed 20-req/min limit and will stall.
MBTA_API_KEY=

# Anthropic API key — OPTIONAL. Only used for plain-language alert text.
# Skip it entirely if you're not doing translation.
ANTHROPIC_API_KEY=
