# MBTA V3 API key (optional, raises rate limits). Server-only. Short alias: mbta=
MBTA_API_KEY=

# Anthropic key (optional): plain-language alerts and UI translation. Without it: MBTA text, English only.
# Short alias: anthropic=
ANTHROPIC_API_KEY=

# Gemini key for the safe-route chat. Without it every chat message gets "I can't help with that".
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_DAILY_LIMIT=200
# GEMINI_MAX_INPUT=500

# ntfy station alerts: secret sent as the x-notify-secret header to POST /api/notify/run.
NOTIFY_SECRET=
# Public app URL used in alert links (defaults to the request origin).
# LASTMILE_URL=https://your-app.vercel.app

# Postgres for users and sessions. Neon: Project > Connect > copy the pooled connection string.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Random 32+ chars: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Site URL. Locally http://localhost:3000; on Vercel your production URL.
BETTER_AUTH_URL=http://localhost:3000

# Optional sign-in buttons. A provider shows up only when both values are set.
# Google callback: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub callback: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
